# GitHub Access Report Service - Configuration

# ----------------------------------------------------------------------
# Authentication (Choose one or provide per-request via HTTP headers)
# ----------------------------------------------------------------------
# 1. Personal Access Token (Classic PAT with 'repo', 'read:org' or fine-grained token)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# 2. GitHub App Authentication (Enterprise alternative)
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=78901234
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# or path to private key:
# GITHUB_APP_PRIVATE_KEY=./github-app-private-key.pem

# ----------------------------------------------------------------------
# API Endpoints
# ----------------------------------------------------------------------
GITHUB_API_URL=https://api.github.com
GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# ----------------------------------------------------------------------
# Performance & Concurrency Tuning
# ----------------------------------------------------------------------
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3
BACKOFF_FACTOR=1.5

# ----------------------------------------------------------------------
# Caching Configuration
# ----------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=100

# ----------------------------------------------------------------------
# Data Collection Strategy ('graphql' or 'rest')
# ----------------------------------------------------------------------
DEFAULT_COLLECTOR=graphql

# ----------------------------------------------------------------------
# Server Settings
# ----------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
